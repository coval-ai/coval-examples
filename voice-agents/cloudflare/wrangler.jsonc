{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coval-demo-voice-agents",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["python_workers"],
  "python_modules": { "exclude": ["**/*.pyc", "openai/**", "PIL/**", "**/*.pyi"] },
  "rules": [
    {
      "type": "Data",
      "globs": ["verticals/data/*.json", "transport/*.wav"],
      "fallthrough": true,
    },
  ],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "AI_GATEWAY_ID": "default",
    "COVAL_API_BASE": "https://api.coval.dev/v1",
  },
  // Secrets (see README):
  //   AGENT_AUTH_TOKEN  bearer token Coval sends on the WebSocket upgrade
  //   COVAL_API_KEYS    JSON map of org name -> Coval API key, for trace export
  "durable_objects": { "bindings": [{ "name": "CALLS", "class_name": "CovalCall" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CovalCall"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
}
